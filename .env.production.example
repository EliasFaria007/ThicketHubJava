# =========================================================================
# Exemplo de Variáveis de Ambiente para Produção (Northflank)
# =========================================================================

# Ativação do perfil de produção
SPRING_PROFILES_ACTIVE=prod

# Porta (Northflank injeta automaticamente via PORT, mas pode ser 8080)
PORT=8080

# Chave secreta para tokens JWT (mínimo de 256 bits em hexadecimal ou base64)
JWT_SECRET=9a8b7c6d5e4f3a2b1c0d9e8f7a6b5c4d3e2f1a0b9c8d7e6f5a4b3c2d1e0f
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Banco de Dados PostgreSQL:
# Se usar Northflank Postgres Addon ou Neon/Supabase, você pode fornecer:
# OPÇÃO A: Uma URL completa (nosso backend converte automaticamente)
DATABASE_URL=postgres://usuario:senha@host:5432/nome_banco?sslmode=require

# OU OPÇÃO B: Variáveis separadas
# DB_URL=jdbc:postgresql://host:5432/nome_banco?sslmode=require
# DB_USERNAME=usuario
# DB_PASSWORD=senha

# Limite de conexões Hikari para plano Free (economiza memória RAM)
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=1

# Redis (Opcional - se usar Addon no Northflank ou Upstash Redis free)
# REDIS_HOST=seu-redis-host.northflank.app
# REDIS_PORT=6379
# REDIS_PASSWORD=sua-senha-redis

# Servidor de Email SMTP (Opcional)
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=seu-email@gmail.com
# MAIL_PASSWORD=sua-senha-de-app

# CORS - Origens adicionais autorizadas (separadas por vírgula)
CORS_ALLOWED_ORIGINS=https://thicket-hub-front.vercel.app,https://api.thickethub.dev.br
